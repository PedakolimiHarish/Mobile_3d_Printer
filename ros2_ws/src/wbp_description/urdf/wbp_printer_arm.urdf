<?xml version="1.0"?>
<robot name="wbp_printer_arm">

    <!-- <link name="robot_arm_base_footprint" /> -->
    <link name="base_footprint" />

    <!-- ========================= -->
    <!-- Base (connects to mobile base later) -->
    <!-- ========================= -->
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0.2" />
            <mass value="120.0" />
            <inertia ixx="0.85" ixy="0" ixz="0" iyy="1.04" iyz="0" izz="1.81" />
        </inertial>

        <visual>
            <origin xyz="0 0 0.1" />
            <geometry>
                <box size="1.0 0.9 0.20" />
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1.0" />
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.1" />
            <geometry>
                <box size="1.0 0.9 0.20" />
            </geometry>
        </collision>
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.26" rpy="0 0 0" />
    </joint>

    <!-- ========================= -->
    <!-- Mast (vertical column) -->
    <!-- ========================= -->
    <link name="mast_link">
        <inertial>
            <origin xyz="0 0 1.1" />
            <mass value="4.0" />
            <inertia ixx="1.62" ixy="0" ixz="0" iyy="1.62" iyz="0" izz="0.0128" />
        </inertial>

        <visual>
            <origin xyz="0 0 1.1" />
            <geometry>
                <cylinder radius="0.08" length="2.2" />
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 0.8 1.0" />
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 1.1" />
            <geometry>
                <cylinder radius="0.08" length="2.2" />
            </geometry>
        </collision>
    </link>

    <!-- Rotary base (locked for now) -->

    <joint name="base_to_mast_joint" type="continuous">
        <parent link="base_link" />
        <child link="mast_link" />
        <origin xyz="0 0 0.2" />
        <axis xyz="0 0 1" />
        <dynamics damping="0.10" friction="0" />

    </joint>

    <!-- ========================= -->
    <!-- Carriage (moves up/down mast) -->
    <!-- ========================= -->
    <link name="carriage_link">
        <inertial>
            <origin xyz="1.5 0 0" />
            <mass value="1" />
            <inertia ixx="0.0094" ixy="0" ixz="0" iyy="0.855" iyz="0" izz="0.861" />
        </inertial>

        <visual>
            <geometry>
                <box size="0.4 0.4 0.2" />
            </geometry>
            <material name="green">
                <color rgba="0.0 0.8 0.0 1.0" />
            </material>
        </visual>

        <visual>
            <origin xyz="1.5 0 0" />
            <geometry>
                <box size="3.0 0.15 0.15" />
            </geometry>
            <material name="green">
                <color rgba="0.0 0.8 0.0 1.0" />
            </material>
        </visual>

        <collision>
            <origin xyz="1.4 0 0" />
            <geometry>
                <box size="3.2 0.3 0.15" />
            </geometry>
        </collision>
    </link>

    <!-- Vertical Z axis -->

    <joint name="mast_to_carriage_joint" type="prismatic">
        <parent link="mast_link" />
        <child link="carriage_link" />
        <origin xyz="0 0 01.10" />
        <axis xyz="0 0 1" />
        <limit lower="-1.0" upper="1.0" effort="2000" velocity="0.2" />
        <dynamics damping="0.10" friction="0" />

    </joint>

    <!-- ========================= -->
    <!-- Tool carriage (horizontal reach) -->
    <!-- ========================= -->
    <link name="tool_link">
        <inertial>
            <origin xyz="1.5 0 0" />
            <mass value="0.5" />
            <inertia
                ixx="0.01"
                ixy="0"
                ixz="0"
                iyy="0.01"
                iyz="0"
                izz="0.01" />
        </inertial>

        <visual>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="0.15 0.15 0.01" />
            </geometry>
            <material name="yellow">
                <color rgba="1.0 0.8 0.0 1.0" />
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="0.15 0.15 0.01" />
            </geometry>
        </collision>

    </link>

    <!-- Horizontal reach -->

    <joint name="carriage_to_tool_joint" type="prismatic">
        <parent link="carriage_link" />
        <child link="tool_link" />
        <origin xyz="1.9 0 -0.080" />
        <axis xyz="1 0 0" />
        <limit lower="-1.0" upper="1" effort="1000" velocity="0.2" />
        <dynamics damping="0.10" friction="0.0" />

    </joint>

    <!-- ========================= -->
    <!-- Toolhead -->
    <!-- ========================= -->
    <link name="toolhead_link">
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="0.7" />
            <inertia
                ixx="0.005"
                ixy="0"
                ixz="0"
                iyy="0.005"
                iyz="0"
                izz="0.005" />
        </inertial>

        <visual>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="0.15 0.15 0.2" />
            </geometry>
            <material name="red">
                <color rgba="0.8 0.0 0.0 1.0" />
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="0.15 0.15 0.2" />
            </geometry>
        </collision>
    </link>

    <!-- Tool offset -->

    <joint name="tool_mount_joint" type="continuous">
        <parent link="tool_link" />
        <child link="toolhead_link" />
        <origin xyz="0 0 -0.105" />
        <axis xyz="0 0 1" />
        <limit effort="100" velocity="0.1" />
        <dynamics damping="0.10" friction="0.0" />

    </joint>

    <!-- ========================= -->
    <!-- Tool0 Frame -->
    <!-- ========================= -->

    <link name="tool0" />

    <joint name="tool0_joint" type="fixed">
        <parent link="toolhead_link" />
        <child link="tool0" />
        <origin xyz="0 0 -0.10" rpy="0 0 0" />
    </joint>

    <!-- ========================= -->
    <!-- Virtual Casters (frictionless contact points) -->
    <!-- ========================= -->
    <link name="virtual_caster_fl">
        <visual>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <material name="transparent">
                <color rgba="0 0 0 0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1e8</kp>
                        <kd>1e5</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
        <inertial>
            <mass value="0.001" />
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </link>

    <joint name="virtual_caster_fl_joint" type="fixed">
        <parent link="base_link" />
        <child link="virtual_caster_fl" />
        <!-- Position: front-left corner. Z = -0.21 so sphere bottom touches ground -->
        <origin xyz="0.45 0.40 -0.18" />
    </joint>

    <link name="virtual_caster_fr">
        <visual>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <material name="transparent">
                <color rgba="0 0 0 0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1e8</kp>
                        <kd>1e5</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
        <inertial>
            <mass value="0.001" />
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </link>

    <joint name="virtual_caster_fr_joint" type="fixed">
        <parent link="base_link" />
        <child link="virtual_caster_fr" />
        <origin xyz="0.45 -0.40 -0.18" />
    </joint>

    <link name="virtual_caster_rl">
        <visual>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <material name="transparent">
                <color rgba="0 0 0 0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1e8</kp>
                        <kd>1e5</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
        <inertial>
            <mass value="0.001" />
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </link>

    <joint name="virtual_caster_rl_joint" type="fixed">
        <parent link="base_link" />
        <child link="virtual_caster_rl" />
        <origin xyz="-0.55 0.40 -0.18" />
    </joint>

    <link name="virtual_caster_rr">
        <visual>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <material name="transparent">
                <color rgba="0 0 0 0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.08" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1e8</kp>
                        <kd>1e5</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
        <inertial>
            <mass value="0.001" />
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </link>

    <joint name="virtual_caster_rr_joint" type="fixed">
        <parent link="base_link" />
        <child link="virtual_caster_rr" />
        <origin xyz="-0.55 -0.40 -0.18" />
    </joint>

    <!-- ========================= -->
    <!-- Drive Wheels -->
    <!-- ========================= -->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.13" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.5707 0 0" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.13" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.5707 0 0" />
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.1</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <inertial>
            <mass value="0.8" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.00605" ixy="0" ixz="0" iyy="0.00676" iyz="0" izz="0.00605" />
        </inertial>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="0 0.38 -0.13" />
        <axis xyz="0 1 0" />
        <dynamics damping="0.1" friction="0.0" />
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.13" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.5707 0 0" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.13" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.5707 0 0" />
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.1</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
        <inertial>
            <mass value="0.8" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.00605" ixy="0" ixz="0" iyy="0.00676" iyz="0" izz="0.00605" />
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="0 -0.38 -0.13" />
        <axis xyz="0 1 0" />
        <dynamics damping="0.1" friction="0.0" />
    </joint>


    <!-- counter Weight -->

    <link name="counterweight">
        <inertial>
            <mass value="10.0" />          <!-- adjust as needed -->
            <origin xyz="0 0 0.1" />
            <inertia ixx="0.167" ixy="0" ixz="0" iyy="0.167" iyz="0" izz="0.267" />
        </inertial>
        <visual>
            <geometry>
                <box size="0.4 0.4 0.2" />
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.4 0.2" />
            </geometry>
        </collision>
    </link>

    <joint name="counterweight_joint" type="fixed">
        <parent link="base_link" />
        <child link="counterweight" />
        <origin xyz="-0.45 0 0" />        <!-- at the rear edge -->
    </joint>


    <!-- ========================= -->
    <!-- Plugins -->
    <!-- ========================= -->

    <ros2_control name="wbp_arm_system" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="base_to_mast_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="mast_to_carriage_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="carriage_to_tool_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="tool_mount_joint">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

    </ros2_control>

    <physics name="default_physics" type="ode">
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
        <ode>
            <solver>
                <type>quick</type>
                <iters>50</iters>
                <sor>1.3</sor>
            </solver>
            <constraints>
                <cfm>0.00001</cfm>
                <erp>0.2</erp>
                <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
                <contact_surface_layer>0.001</contact_surface_layer>
            </constraints>
        </ode>
    </physics>

    <sensor name="gpu_ray" type="gpu_ray">
        <update_rate>60.0</update_rate>
    </sensor>

    <gazebo>

        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>
                /home/guru/wbp_controller/ros2_ws/install/wbp_sim_gazebo/share/wbp_sim_gazebo/config/robot_controllers.yaml
            </parameters>

            <param name="position_proportional_gain">5.0</param>

        </plugin>

        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.76</wheel_separation>
            <wheel_radius>0.13</wheel_radius>

            <!-- Performance Limits -->
            <max_linear_velocity>0.5</max_linear_velocity>
            <max_angular_velocity>0.3</max_angular_velocity>
            <max_linear_acceleration>0.3</max_linear_acceleration>
            <max_angular_acceleration>0.2</max_angular_acceleration>

            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>

            <odom_publish_frequency>50</odom_publish_frequency>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <publish_odom_tf>false</publish_odom_tf>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>

            <joint_name>base_to_mast_joint</joint_name>
            <joint_name>mast_to_carriage_joint</joint_name>
            <joint_name>carriage_to_tool_joint</joint_name>
            <joint_name>tool_mount_joint</joint_name>
        </plugin>
    </gazebo>

</robot>